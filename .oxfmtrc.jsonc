{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "ignorePatterns": ["tools/oxlint/anti-slop/**"],
  "insertFinalNewline": true,
  "printWidth": 100,
  "proseWrap": "preserve",
  "semi": false,
  "singleQuote": false,
  "sortImports": true,
  "sortPackageJson": {
    "sortScripts": true,
  },
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
}
