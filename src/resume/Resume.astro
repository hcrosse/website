---
import '@fontsource/archivo/latin-400.css';
import '@fontsource/archivo/latin-600.css';
import '@fontsource/chivo-mono/latin-400.css';
import '@fontsource/chivo-mono/latin-600.css';
import { sortToolItems, type ResumeContent } from './content';

interface Props {
  content: ResumeContent;
  theme: 'light' | 'dark';
}

const { content, theme } = Astro.props;
---

<div class="resume" data-theme={theme}>
  <svg class="icon-definitions" aria-hidden="true">
    <defs>
      <symbol id="icon-location" viewBox="0 0 24 24">
        <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
        <circle cx="12" cy="10" r="2.5"></circle>
      </symbol>
      <symbol id="icon-email" viewBox="0 0 24 24">
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <path d="m3 7 9 6 9-6"></path>
      </symbol>
      <symbol id="icon-phone" viewBox="0 0 24 24">
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.33 1.84.56 2.8.69A2 2 0 0 1 22 16.92Z"
        ></path>
      </symbol>
      <symbol id="icon-linkedin" viewBox="0 0 24 24">
        <path
          d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V8.98h3.42v1.57h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.29ZM5.32 7.41a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.04H3.54V8.98H7.1v11.47Z"
        ></path>
      </symbol>
      <symbol id="icon-github" viewBox="0 0 24 24">
        <path
          d="M12 .3a12 12 0 0 0-3.79 23.4c.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.31-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18a4.64 4.64 0 0 1 1.23 3.22c0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.3c0 .32.22.7.83.58A12 12 0 0 0 12 .3Z"
        ></path>
      </symbol>
    </defs>
  </svg>

  <header class="resume-header">
    <h1>{content.identity.name}</h1>

    <address>
      <ul>
        <li>
          <svg aria-hidden="true"><use href="#icon-location"></use></svg>
          <span>{content.identity.location}</span>
        </li>
        <li>
          <svg aria-hidden="true"><use href="#icon-email"></use></svg>
          <a href={`mailto:${content.identity.email}`}
            >{content.identity.email}</a
          >
        </li>
        <li>
          <svg aria-hidden="true"><use href="#icon-phone"></use></svg>
          <a href="tel:+17034727202">{content.identity.phone}</a>
        </li>
        <li>
          <svg class="brand-icon" aria-hidden="true"
            ><use href="#icon-linkedin"></use></svg
          >
          <a href={content.identity.linkedin.url}
            >{content.identity.linkedin.handle}</a
          >
        </li>
        <li>
          <svg class="brand-icon" aria-hidden="true"
            ><use href="#icon-github"></use></svg
          >
          <a href={content.identity.github.url}
            >{content.identity.github.handle}</a
          >
        </li>
      </ul>
    </address>
  </header>

  <main class="resume-body">
    <section class="employment" aria-labelledby="employment-heading">
      <h2 id="employment-heading">Employment</h2>
      {
        content.employment.map((job) => (
          <article class="employment-entry">
            <header>
              <h3>{job.company}</h3>
            </header>
            <div class="role-list">
              {
                job.roles.map((role) => (
                  <div class="role-entry">
                    <p>{role.title}</p>
                    <p class="dates">
                      {role.start} - {role.end}
                    </p>
                  </div>
                ))
              }
            </div>
            <ul>
              {job.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>

    <div class="utility">
      <section aria-labelledby="selected-work-heading">
        <h2 id="selected-work-heading">Selected Work</h2>
        {
          content.selectedWork.map((work) => (
            <article class="selected-work-entry">
              <h3>
                {work.url ? <a href={work.url}>{work.name}</a> : work.name}
              </h3>
              <p>{work.description}</p>
              {work.url && <p class="work-url">{work.url}</p>}
            </article>
          ))
        }
      </section>

      <section aria-labelledby="education-heading">
        <h2 id="education-heading">Education</h2>
        <h3>{content.education.institution}</h3>
        <p>{content.education.degree}</p>
        <p class="education-minor">{content.education.minor}</p>
        <p class="education-year">{content.education.year}</p>
      </section>

      <section aria-labelledby="tools-heading">
        <h2 id="tools-heading">Tools</h2>
        <div class="tool-groups">
          {
            content.tools.map((group) => (
              <div class="tool-group">
                <h3 class="tool-category">{group.category}</h3>
                <ul class="tool-list">
                  {sortToolItems(group.items).map((tool) => (
                    <li>{tool}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </main>
</div>

<style>
  .resume,
  .resume * {
    box-sizing: border-box;
  }

  .resume {
    width: 8.5in;
    height: 11in;
    padding: 0.55in;
    background: var(--resume-background);
    color: var(--resume-text);
    font-family: 'Archivo', Arial, Helvetica, sans-serif;
    font-size: 9.5pt;
    line-height: 1.35;
    print-color-adjust: exact;
  }

  .resume[data-theme='light'] {
    --resume-background: #f2f2f2;
    --resume-text: #0d0d0d;
    --resume-muted: #333e42;
    --resume-accent: #566e49;
  }

  .resume[data-theme='dark'] {
    --resume-background: #0d0d0d;
    --resume-text: #f2f2f2;
    --resume-muted: #b8c0c2;
    --resume-accent: #6b8a5c;
  }

  .resume-header {
    border-bottom: 1.5pt solid var(--resume-accent);
    padding-bottom: 0.2in;
  }

  h1,
  h2,
  h3,
  p,
  ul {
    margin: 0;
  }

  h1 {
    color: var(--resume-accent);
    font-size: 34pt;
    font-weight: 600;
    letter-spacing: -0.8pt;
    line-height: 1;
  }

  address {
    margin-top: 0.14in;
    color: var(--resume-muted);
    font-family: 'Chivo Mono', monospace;
    font-size: 8pt;
    font-style: normal;
  }

  address ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.08in 0.2in;
    padding: 0;
    list-style: none;
  }

  address li {
    display: inline-flex;
    align-items: center;
    gap: 0.05in;
  }

  address svg {
    width: 0.12in;
    height: 0.12in;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  address .brand-icon {
    fill: currentColor;
    stroke: none;
  }

  .icon-definitions {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .resume-body {
    display: grid;
    grid-template-columns: minmax(0, 68fr) minmax(0, 32fr);
    gap: 0.38in;
    padding-top: 0.28in;
  }

  h2 {
    margin-bottom: 0.16in;
    color: var(--resume-accent);
    font-family: 'Chivo Mono', monospace;
    font-size: 8.5pt;
    font-weight: 600;
    letter-spacing: 1pt;
    text-transform: uppercase;
  }

  h3 {
    font-size: 11pt;
    font-weight: 600;
    line-height: 1.15;
  }

  .employment-entry {
    break-inside: avoid;
  }

  .employment-entry + .employment-entry {
    margin-top: 0.2in;
  }

  .role-list {
    margin-top: 0.03in;
  }

  .role-entry {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 0.18in;
  }

  .role-entry + .role-entry {
    margin-top: 0.03in;
  }

  .role-entry > p:not(.dates) {
    color: var(--resume-muted);
  }

  .dates,
  .work-url,
  .education-year {
    color: var(--resume-muted);
    font-family: 'Chivo Mono', monospace;
    font-size: 7.5pt;
  }

  .dates {
    flex: none;
    padding-top: 0.02in;
    white-space: nowrap;
  }

  .employment-entry ul {
    margin-top: 0.09in;
    padding-left: 0.16in;
  }

  .employment-entry li + li {
    margin-top: 0.05in;
  }

  .utility {
    border-left: 1pt solid var(--resume-muted);
    padding-left: 0.28in;
  }

  .utility section {
    break-inside: avoid;
  }

  .utility section + section {
    margin-top: 0.3in;
  }

  .tool-group + .tool-group {
    margin-top: 0.16in;
  }

  .tool-category {
    margin-bottom: 0.02in;
    color: var(--resume-muted);
    font-family: 'Chivo Mono', monospace;
    font-size: 7pt;
    font-weight: 600;
    letter-spacing: 0.45pt;
    text-transform: uppercase;
  }

  .tool-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.04in 0.06in;
    padding: 0;
    font-family: 'Chivo Mono', monospace;
    font-size: 7.5pt;
    list-style: none;
  }

  .tool-list li {
    padding: 0 0.04in;
    border-bottom: 0.5pt solid var(--resume-muted);
  }

  .selected-work-entry {
    break-inside: avoid;
  }

  .selected-work-entry + .selected-work-entry {
    margin-top: 0.18in;
  }

  .selected-work-entry > p,
  .utility section > p {
    margin-top: 0.07in;
  }

  .selected-work-entry .work-url {
    margin-top: 0.05in;
    overflow-wrap: anywhere;
  }

  .education-minor {
    color: var(--resume-muted);
  }
</style>
