---
import Resume from '../../../../src/resume/Resume.astro';
import { generalResume } from '../../../../src/resume/content';

type Props = { theme: 'light' | 'dark' };

export function getStaticPaths(): Array<{ params: { theme: string }; props: Props }> {
  return [
    { params: { theme: 'light' }, props: { theme: 'light' } },
    { params: { theme: 'dark' }, props: { theme: 'dark' } },
  ];
}

const { theme } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{generalResume.identity.name} Resume</title>
  </head>
  <body>
    <Resume content={generalResume} theme={theme} />
  </body>
</html>

<style>
  @page {
    size: Letter;
    margin: 0;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    background: #0d0d0d;
  }

  @media print {
    body {
      background: transparent;
    }
  }
</style>
