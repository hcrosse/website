---
import Resume from '../../../../src/resume/Resume.astro';
import { resume } from '../../../../src/resume/content';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{resume.identity.name} Resume</title>
  </head>
  <body>
    <Resume content={resume} />
  </body>
</html>

<style>
  @page {
    size: Letter;
    margin: 0;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    background: #0d0d0d;
  }

  @media print {
    body {
      background: transparent;
    }
  }
</style>
