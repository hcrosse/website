{
  "name": "website",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "check": "prek run --all-files && bun run format:check",
    "check:build": "bun run check && bun run build",
    "dev": "astro dev",
    "build": "astro build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "bun run lint:code && bun run lint:workflows",
    "lint:code": "oxlint .",
    "lint:workflows": "actionlint && zizmor --offline --strict-collection --collect=workflows .",
    "preview": "bun run build && wrangler dev",
    "astro": "astro",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "setup": "bun ci && prek install"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.17.1",
    "remark-breaks": "^4.0.0",
    "satori": "^0.19.2",
    "tailwindcss": "^4.1.18",
    "wrangler": "^4.68.0"
  },
  "devDependencies": {
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0"
  },
  "packageManager": "bun@1.3.14"
}
